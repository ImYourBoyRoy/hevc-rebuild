        "selector": {
          "file": "desktop/src/lib/RunProgress.svelte",
          "kind": "button"
        },
        "kind": "app-click"
      },
      {
        "id": "safe-stop",
        "label": "Stop after this file",
        "selector": {
          "file": "desktop/src/lib/RunProgress.svelte",
          "kind": "button"
        },
        "kind": "app-click"
      },
      {
        "id": "stop-now",
        "label": "Stop now",
