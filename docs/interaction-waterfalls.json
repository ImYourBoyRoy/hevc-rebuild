        "label": "I reviewed the destinations and understand this starts real encodes.",
        "selector": {
          "file": "desktop/src/routes/+page.svelte",
          "kind": "form-control"
        },
        "kind": "form-control",
        "clicks": 1,
        "conditional": true,
        "note": "Rendered only for full mode; the checkbox tap is counted."
      },
      {
        "id": "output-confirm",
        "label": "Confirm destinations and start / Start full rebuild",
        "selector": {
          "file": "desktop/src/routes/+page.svelte",
          "kind": "button"
        },
        "kind": "app-click"
      }
    ],
    "run-active": [
      {
        "id": "progress-details",
