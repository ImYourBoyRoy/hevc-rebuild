  "actions": {
    "navigate-youtube": {
      "label": "YouTube navigation item",
      "state": "library-empty-ready",
      "selector": {
        "file": "desktop/src/routes/+page.svelte",
        "kind": "button"
      },
      "type": "app-click",
      "cost": {
        "app": 1
      },
      "next": "youtube-ready",
      "note": "One runtime instance is the YouTube item in the primary navigation loop."
    },
