  "states": [
    {
      "id": "startup-loading",
      "title": "Application loading",
      "condition": "booting || environmentLoading || native shell initialization",
      "activeControls": [
        {
          "group": "shell",
          "exclude": [
            "choose-media-folder-sidebar"
          ]
        }
      ],
      "disabledControls": [
        {
          "selector": {
            "file": "desktop/src/routes/+page.svelte",
            "kind": "button"
          },
          "label": "Choose media folder",
          "kind": "app-click",
          "note": "browseFolder() returns until desktopShell is ready."
        },
        {
          "selector": {
            "file": "desktop/src/routes/+page.svelte",
            "kind": "button",
            "label": "Add folder"
          },
          "label": "Add folder",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/routes/+page.svelte",
            "kind": "button",
            "label": "Add files"
          },
          "label": "Add files",
          "kind": "app-click"
        }
      ],
      "automatic": [
        {
          "id": "initialize",
          "label": "Load preferences, queue, environment and reports",
          "type": "automatic",
          "next": "library-empty-ready",
          "source": "desktop/src/routes/+page.svelte:3900-3963"
        }
      ],
      "notes": [
        "The shell is rendered during boot, but native actions are not a reliable task starting point until desktopShell and initialization are ready.",
        "Waiting for initialization costs zero clicks."
      ]
    },
    {
      "id": "library-empty-ready",
      "title": "Library page with an empty queue",
      "condition": "page === library || home, desktopShell, !scanResult, !scanning",
      "activeControls": [
        {
          "group": "shell"
        },
        {
          "group": "library-empty"
        }
      ],
      "notes": [
        "This is the first task state after the loading wait. Add folder and Add files are enabled here.",
        "Scan options is a disclosure; its nested Add path control is not active until the disclosure is opened."
      ]
    },
    {
      "id": "native-folder-picker",
      "title": "Native folder picker",
      "condition": "openDialog({ directory: true, multiple: true })",
      "activeControls": [],
      "systemControls": [
        {
          "id": "picker-navigation",
          "label": "Navigate and select folder(s)",
          "type": "native-navigation",
          "cost": {
            "variables": {
              "pickerNavigationClicks": 1
            }
          }
        },
        {
          "id": "picker-confirm",
          "label": "Confirm selection in the OS picker",
          "type": "native-confirm",
          "cost": {
            "native": 1
          }
        },
        {
          "id": "picker-cancel",
          "label": "Cancel picker",
          "type": "native-cancel",
          "cost": {
            "native": 1
          },
          "alternative": true
        }
      ],
      "automatic": [
        {
          "id": "scan-folder",
          "label": "Scan selected source(s) and update the queue",
          "type": "automatic",
          "next": "library-ready",
          "source": "desktop/src/routes/+page.svelte:3986-3990, 1456-1555"
        }
      ],
      "notes": [
        "x is user- and OS-dependent picker navigation/selection. The final native confirmation is counted as one separate click.",
        "Cancel is a branch, not part of a completed task path."
      ]
    },
    {
      "id": "native-file-picker",
      "title": "Native file picker",
      "condition": "openDialog({ directory: false, multiple: true, video filters })",
      "activeControls": [],
      "systemControls": [
        {
          "id": "picker-navigation",
          "label": "Navigate and select file(s)",
          "type": "native-navigation",
          "cost": {
            "variables": {
              "pickerNavigationClicks": 1
            }
          }
        },
        {
          "id": "picker-confirm",
          "label": "Confirm selection in the OS picker",
          "type": "native-confirm",
          "cost": {
            "native": 1
          }
        },
        {
          "id": "picker-cancel",
          "label": "Cancel picker",
          "type": "native-cancel",
          "cost": {
            "native": 1
          },
          "alternative": true
        }
      ],
      "automatic": [
        {
          "id": "scan-files",
          "label": "Scan selected file(s) and update the queue",
          "type": "automatic",
          "next": "library-ready",
          "source": "desktop/src/routes/+page.svelte:3982-3994, 1456-1555"
        }
      ],
      "notes": [
        "The same x variable covers file-picker navigation/selection; multi-select may add user-dependent clicks."
      ]
    },
    {
      "id": "library-ready",
      "title": "Library page with a completed scan",
      "condition": "page === library, scanResult, selectedRunEntries ready",
      "activeControls": [
        {
          "group": "shell"
        },
        {
          "group": "library-queue"
        },
        {
          "group": "library-tasks"
        }
      ],
      "conditionalControls": [
        {
          "selector": {
            "file": "desktop/src/lib/LibraryPosterGrid.svelte",
            "kind": "button"
          },
          "all": true,
          "label": "Per-card review, selection, output and recovery controls"
        }
      ],
      "notes": [
        "The five task buttons are visible together in the library action row when a runnable selection exists.",
        "Per-file card buttons are repeated runtime instances; the source map reports their template once and retains Each(...) guards."
      ]
    },
    {
      "id": "run-page-ready",
      "title": "Run page before launch",
      "condition": "page === run, no active run, at least one ready selected entry",
      "activeControls": [
        {
          "group": "shell"
        },
        {
          "group": "run-setup",
          "exclude": [
            "choose-rebuild-folder",
            "use-default-location"
          ]
        }
      ],
      "conditionalControls": [
        {
          "group": "run-setup",
          "include": [
            "choose-rebuild-folder",
            "use-default-location"
          ]
        }
      ],
      "notes": [
        "Selecting a mode is one app click when the user starts from the generic Run page.",
        "A library task shortcut skips the mode-tab and launch clicks by calling chooseLibraryTask() → beginRun() automatically."
      ]
    },
    {
      "id": "output-preview-metadata",
      "title": "Metadata output review modal",
      "condition": "outputPreviewOpen && outputPreview.mode === metadata",
      "activeControls": [
        {
          "group": "output-review",
          "exclude": [
            "full-rebuild-ack"
          ]
        }
      ],
      "notes": [
        "The happy-path confirm button is enabled only when the output preview is eligible.",
        "The modal makes the final confirmation click explicit; starting the native run after it is automatic."
      ]
    },
    {
      "id": "output-preview-full-unacknowledged",
      "title": "Full rebuild output review before acknowledgment",
      "condition": "outputPreviewOpen && outputPreview.mode === full && !fullAck",
      "activeControls": [
        {
          "group": "output-review",
          "include": [
            "close-output-review",
            "output-back",
            "adjust-output-folders",
            "full-rebuild-ack",
            "output-confirm"
          ]
        }
      ],
      "notes": [
        "The primary button is rendered but disabled until the acknowledgment checkbox is tapped."
      ]
    },
    {
      "id": "output-preview-full-ready",
      "title": "Full rebuild output review after acknowledgment",
      "condition": "outputPreviewOpen && outputPreview.mode === full && fullAck",
      "activeControls": [
        {
          "group": "output-review",
          "exclude": [
            "full-rebuild-ack"
          ]
        }
      ]
    },
    {
      "id": "run-active",
      "title": "Active run / progress",
      "condition": "workspace.run.id || workspace.run.starting",
      "activeControls": [
        {
          "group": "run-active"
        }
      ],
      "notes": [
        "The encode, validation, report write, and transition to completion are automatic; progress observation costs zero clicks."
      ]
    },
    {
      "id": "finished",
      "title": "Workflow finished",
      "condition": "run completes, validates, records its report, and returns to an idle state",
      "activeControls": [],
      "automatic": [],
      "notes": [
        "The finished MKV or report is an outcome, not another click. Any post-run inspection, opening a folder, or retry is a separate task."
      ]
    },
    {
      "id": "stop-confirmation",
      "title": "Stop-now confirmation modal",
      "condition": "abortConfirmOpen",
      "activeControls": [
        {
          "group": "stop-confirmation"
        }
      ],
      "notes": [
        "The modal is the intentional extra click for an immediate stop."
      ]
    },
    {
      "id": "youtube-ready",
      "title": "YouTube page with a ready source",
      "condition": "page === youtube, scanResult, no active run",
      "activeControls": [
        {
          "group": "shell"
        },
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button",
            "label": "Add folder"
          },
          "label": "Add folder",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button",
            "label": "Add files"
          },
          "label": "Add files",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button",
            "labelIncludes": "Upscale"
          },
          "label": "Upscale",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button",
            "labelIncludes": "Optimize"
          },
          "label": "Optimize",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button",
            "occurrence": 1
          },
          "label": "Choose folder",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button",
            "label": "Create upload copies"
          },
          "label": "Create upload copies",
          "kind": "app-click"
        }
      ],
      "conditionalControls": [
        {
          "selector": {
            "file": "desktop/src/lib/YouTubePreparation.svelte",
            "kind": "button"
          },
          "all": true,
          "label": "Conditional source, selection, pagination and run controls"
        }
      ]
    },
    {
      "id": "metadata-organizer",
      "title": "Metadata organizer rename review",
      "condition": "page === metadata, organizerScan, selected paths",
      "activeControls": [
        {
          "selector": {
            "file": "desktop/src/lib/MetadataWorkbench.svelte",
            "kind": "button"
          },
          "label": "Review MKV output plan",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/MetadataWorkbench.svelte",
            "kind": "button"
          },
          "label": "Preview before/after",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/MetadataWorkbench.svelte",
            "kind": "button"
          },
          "label": "Apply reviewed rename",
          "kind": "app-click"
        },
        {
          "selector": {
            "file": "desktop/src/lib/MetadataWorkbench.svelte",
            "kind": "button"
          },
          "label": "Confirm rename",
          "kind": "app-click"
        }
      ],
      "notes": [
        "Text-entry and provider lookup are represented as non-click work; the rename click budget counts only preview, apply, and confirm controls."
      ]
    },
    {
      "id": "help-page",
      "title": "Help and commands page",
      "condition": "page === help",
      "activeControls": [
        {
          "group": "shell"
        },
        {
          "selector": {
            "file": "desktop/src/lib/HelpCenter.svelte",
            "kind": "button"
          },
          "all": true,
          "label": "Copy command/configuration actions"
        },
        {
          "selector": {
            "file": "desktop/src/lib/HelpCenter.svelte",
            "kind": "link"
          },
          "all": true,
          "label": "External installation and protocol links",
          "kind": "external-link"
        }
      ]
    },
    {
      "id": "settings-page",
      "title": "Settings page control surface",
      "condition": "page === settings",
      "activeControls": [
        {
          "group": "shell"
        }
      ],
      "conditionalControls": [
        {
          "selector": {
            "file": "desktop/src/lib/SettingsPreferences.svelte",
            "kind": "button"
          },
          "all": true,
          "label": "Settings buttons (source-conditional)"
        },
        {
          "selector": {
            "file": "desktop/src/lib/SettingsPreferences.svelte",
            "kind": "link"
          },
          "all": true,
          "label": "Settings anchors and provider links",
          "kind": "link"
        }
      ],
      "notes": [
        "Settings has many data-dependent controls. The state inventory lists every source control with its guard; a live settings snapshot is still needed to call one exact subset active."
      ]
    },
    {
      "id": "reports-page",
      "title": "Reports page control surface",
      "condition": "page === reports",
      "activeControls": [
        {
          "group": "shell"
        }
      ],
      "conditionalControls": [
        {
          "selector": {
            "file": "desktop/src/lib/ReportBrowser.svelte",
