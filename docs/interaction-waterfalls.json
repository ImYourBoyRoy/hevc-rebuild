    "pickerNavigationClicks": {
      "symbol": "x",
      "label": "native picker navigation and selection clicks",
      "description": "The number of OS file-picker clicks needed to navigate to and select the source. It varies by platform, starting folder, and the user's path. The native picker confirmation is counted separately."
    }
