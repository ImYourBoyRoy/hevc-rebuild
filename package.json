{
  "name": "hevc-rebuild-studio-workspace",
  "version": "1.4.1",
  "private": true,
  "description": "Workspace command shortcuts for the HEVC Rebuild Studio desktop client.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "ui:dev": "pnpm --dir desktop dev",
    "ui:build": "pnpm --dir desktop build",
    "ui:check": "pnpm --dir desktop check",
    "ui:check:tsgo": "pnpm --dir desktop check:tsgo",
    "ui:tauri": "pnpm --dir desktop tauri",
    "interaction-map": "node tools/interaction-map.mjs",
    "interaction-map:check": "node tools/interaction-map.mjs --check",
    "interaction-waterfall": "node tools/interaction-waterfall.mjs",
    "interaction-waterfall:check": "node tools/interaction-waterfall.mjs --check",
    "architecture": "node tools/architecture-map.mjs",
    "architecture:check": "node tools/architecture-map.mjs --check"
  }
}
