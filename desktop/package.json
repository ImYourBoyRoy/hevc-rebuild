{
  "name": "hevc-rebuild-studio",
  "version": "1.3.0",
  "description": "Ubuntu desktop studio for safe HEVC library rebuilds",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || ^26.0.0"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:tsgo": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:metadata-matching": "node --experimental-strip-types --test tests/metadata-match.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "^1.52.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
